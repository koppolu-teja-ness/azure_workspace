{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/migration-spec/v1.0.0.schema.json",
  "title": "Migration Spec v1.0.0",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "specVersion",
    "source",
    "target",
    "resources",
    "dependencies",
    "risk",
    "validationHints",
    "traceability"
  ],
  "properties": {
    "specVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "subscriptionId", "region"],
      "properties": {
        "provider": {"const": "azure"},
        "subscriptionId": {"type": "string", "minLength": 1},
        "region": {"type": "string", "minLength": 1}
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "accountId", "region"],
      "properties": {
        "provider": {"const": "aws"},
        "accountId": {"type": "string", "pattern": "^[0-9]{12}$"},
        "region": {"type": "string", "minLength": 1}
      }
    },
    "resources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "serviceArea",
          "sourceType",
          "targetType",
          "name",
          "decision",
          "properties"
        ],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "serviceArea": {
            "type": "string",
            "enum": ["KeyVault", "Functions", "VNet"]
          },
          "sourceType": {"type": "string", "minLength": 1},
          "targetType": {"type": "string", "minLength": 1},
          "name": {"type": "string", "minLength": 1},
          "decision": {
            "type": "string",
            "enum": ["auto-migratable", "needs-review", "high-risk"]
          },
          "properties": {"type": "object"},
          "notes": {"type": "string"}
        }
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from", "to", "kind"],
        "properties": {
          "from": {"type": "string", "minLength": 1},
          "to": {"type": "string", "minLength": 1},
          "kind": {"type": "string", "minLength": 1}
        }
      }
    },
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["overallScore", "classification", "dimensions"],
      "properties": {
        "overallScore": {"type": "number", "minimum": 0, "maximum": 100},
        "classification": {
          "type": "string",
          "enum": ["auto-migratable", "needs-review", "high-risk"]
        },
        "dimensions": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "identityExposure",
            "networkExposure",
            "unsupportedMappingRisk",
            "blastRadius"
          ],
          "properties": {
            "identityExposure": {"type": "number", "minimum": 0, "maximum": 100},
            "networkExposure": {"type": "number", "minimum": 0, "maximum": 100},
            "unsupportedMappingRisk": {"type": "number", "minimum": 0, "maximum": 100},
            "blastRadius": {"type": "number", "minimum": 0, "maximum": 100}
          }
        }
      }
    },
    "validationHints": {
      "type": "array",
      "items": {"type": "string"}
    },
    "traceability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceCommit", "generatedAt", "generatedBy"],
      "properties": {
        "sourceCommit": {"type": "string", "minLength": 7},
        "generatedAt": {"type": "string", "format": "date-time"},
        "generatedBy": {"type": "string", "minLength": 1}
      }
    }
  }
}
