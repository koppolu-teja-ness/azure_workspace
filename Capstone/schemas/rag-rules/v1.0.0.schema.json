{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/rag-rules/v1.0.0.schema.json",
  "title": "RAG Mapping Rule v1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "azureResourceType",
    "awsResourceType",
    "propertyMappings",
    "preconditions",
    "securityConstraints",
    "knownIncompatibilities",
    "fallbackStrategy",
    "confidenceScore",
    "citations",
    "mappingQuality"
  ],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "azureResourceType": {"type": "string", "minLength": 1},
    "awsResourceType": {"type": "string", "minLength": 1},
    "propertyMappings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "target", "notes"],
        "properties": {
          "source": {"type": "string", "minLength": 1},
          "target": {"type": "string", "minLength": 1},
          "notes": {"type": "string", "minLength": 1}
        }
      }
    },
    "preconditions": {
      "type": "array",
      "items": {"type": "string"}
    },
    "securityConstraints": {
      "type": "array",
      "items": {"type": "string"}
    },
    "knownIncompatibilities": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string"}
    },
    "fallbackStrategy": {"type": "string", "minLength": 1},
    "confidenceScore": {"type": "number", "minimum": 0, "maximum": 1},
    "citations": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "mappingQuality": {
      "type": "string",
      "enum": ["exact", "approximate", "manual-required"]
    }
  }
}
