# Azure
AZURE_SUBSCRIPTION_ID=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
# Optional: Azure cloud environment name (public cloud default)
AZURE_CLOUD=AzureCloud

# AWS (sandbox account)
AWS_PROFILE=migration-sandbox
AWS_REGION=us-east-1
AWS_DEFAULT_REGION=us-east-1
# If not using AWS_PROFILE, set static key credentials (sample placeholders)
AWS_ACCESS_KEY_ID=AKIAEXAMPLE0000000000
AWS_SECRET_ACCESS_KEY=exampleSecretKeyReplaceMe1234567890
# Optional for temporary STS credentials
AWS_SESSION_TOKEN=

# Knowledge base / Postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/migration_kb
RAG_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/migration_kb

# RAG retrieval + ingestion defaults
RAG_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
RAG_CHUNK_SIZE=900
RAG_CHUNK_OVERLAP=150

# LLM provider credentials/endpoints (provider selection happens in GraphState config)
# Current implementation uses AWS Bedrock when enabled.
# Keep empty if you run deterministic-only mode.
BEDROCK_REGION=us-east-1

# Optional/future provider path (not used by current Bedrock runtime flow)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=

# Observability
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=azure-aws-migration-assistant

# Optional: LangSmith endpoint override
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
