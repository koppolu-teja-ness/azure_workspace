{
  "azure_resource_type": "Microsoft.Network/virtualNetworks/virtualNetworkPeerings",
  "property_mappings": [
    {
      "azure_property": "remoteVirtualNetwork",
      "aws_property": "PeerVpcId",
      "required": true,
      "notes": [
        "Cross-account peering requires additional role and route coordination."
