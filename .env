# Azure
AZURE_SUBSCRIPTION_ID=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# AWS (sandbox account)
AWS_PROFILE=migration-sandbox
AWS_REGION=us-east-1

# Knowledge base / Postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/migration_kb

# LLM provider — pick one path per the tech stack (Bedrock or Azure OpenAI)
BEDROCK_REGION=us-east-1
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=

# Observability
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=azure-aws-migration-assistant
